PORT=3000

JWT_SECRET=replace-with-a-long-random-secret

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

ADMIN_EMAIL_1=your-first-admin-email
ADMIN_PASSWORD_1=your-first-admin-password

ADMIN_EMAIL_2=your-second-admin-email
ADMIN_PASSWORD_2=your-second-admin-password

# Firebase Admin / Firestore / Storage
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Optional: if you prefer to send a JSON service-account env variable instead of a file
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
